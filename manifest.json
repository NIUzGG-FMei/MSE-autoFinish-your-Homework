{
  "manifest_version": 3,
  "name": "MSE-加速英语老师的消化系统！",
  "version": "1.0.0",
  "description": "MSE 微课平台辅助工具：一键补满学习时长、自动完成必做练习。仅适配《农林院校专业学位研究生英语》。",
  "minimum_chrome_version": "111",
  "content_scripts": [
    {
      "matches": ["https://microlesson.rcgtjy.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
